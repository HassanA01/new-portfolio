# Local dev (docker compose provides this to the web container automatically;
# set it in .env.local for host-side drizzle commands)
# Note: host port 5434 → container 5432 (avoids clashing with a native postgres on 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/portfolio

# Auth.js — GitHub OAuth app (Settings → Developer settings → OAuth Apps)
# Dev callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Vercel AI Gateway (create a key in Vercel dashboard → AI Gateway → API keys;
# deployed environments can use OIDC instead)
AI_GATEWAY_API_KEY=

# Resend (auto-provisioned by `vercel integration add resend`)
RESEND_API_KEY=
