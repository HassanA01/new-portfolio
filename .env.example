# Local: http://localhost:3000. On Vercel: your canonical https:// domain.
APP_URL=http://localhost:3000
# Restricted Stripe API key: Checkout Sessions write, PaymentIntents and Charges read.
# Use a sandbox key for development. Never prefix this with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
# Signing secret for the endpoint /api/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Publishable key for the in-page checkout modal (Stripe Elements; safe to expose to the browser).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Anike: direct provider APIs. Choose provider/model-id and set its key.
# Example OpenAI alternative: AI_MODEL=openai/gpt-5.4-mini
AI_MODEL=anthropic/claude-sonnet-5-5
# Required when AI_MODEL starts with anthropic/. Server-only.
ANTHROPIC_API_KEY=
# Required when AI_MODEL starts with openai/. Server-only.
OPENAI_API_KEY=

# Optional: share rate-limit counters across server instances (lib/rate-limit.ts).
# Without these the limiter keeps counters in memory, per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Self-hosted behind your own reverse proxy (nginx, Caddy, a load balancer)? Set
# this so the limiter reads the client IP from x-real-ip / x-forwarded-for. Leave
# unset on Vercel (detected automatically) and when nothing sits in front of the
# app, where those headers could be forged; all callers then share one limit.
TRUST_PROXY=
